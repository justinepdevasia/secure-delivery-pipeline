{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "external-secrets.io/v1 ExternalSecret, vendored so kubeconform can run with -strict instead of -ignore-missing-schemas. Reduced to the fields this chart uses; unknown properties are rejected so a typo in values-prod.yaml fails the render.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "type": "string", "enum": ["external-secrets.io/v1"] },
    "kind": { "type": "string", "enum": ["ExternalSecret"] },
    "metadata": { "type": "object" },
    "spec": {
      "type": "object",
      "required": ["secretStoreRef", "target"],
      "additionalProperties": false,
      "properties": {
        "refreshInterval": { "type": "string" },
        "secretStoreRef": {
          "type": "object",
          "required": ["name", "kind"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "kind": { "type": "string", "enum": ["SecretStore", "ClusterSecretStore"] }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "creationPolicy": {
              "type": "string",
              "enum": ["Owner", "Orphan", "Merge", "None"]
            },
            "deletionPolicy": { "type": "string", "enum": ["Delete", "Merge", "Retain"] },
            "template": { "type": "object" }
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["secretKey", "remoteRef"],
            "properties": {
              "secretKey": { "type": "string" },
              "remoteRef": {
                "type": "object",
                "required": ["key"],
                "properties": {
                  "key": { "type": "string" },
                  "property": { "type": "string" },
                  "version": { "type": "string" }
                }
              }
            }
          }
        },
        "dataFrom": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "extract": {
                "type": "object",
                "required": ["key"],
                "additionalProperties": false,
                "properties": {
                  "key": { "type": "string" },
                  "version": { "type": "string" },
                  "conversionStrategy": { "type": "string" },
                  "decodingStrategy": { "type": "string" }
                }
              },
              "find": { "type": "object" }
            }
          }
        }
      }
    },
    "status": { "type": "object" }
  }
}
